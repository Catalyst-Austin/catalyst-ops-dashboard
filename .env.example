# Vera Status Dashboard — environment variables
# Copy to .env.local for local dev. Set the same values in Vercel for production.

# Fine-grained PAT with contents:read on Catalyst-Internal/vera (private repo).
VITE_GITHUB_TOKEN=

# The vera repo (source of dossiers + WO state mirror)
VITE_VERA_REPO=Catalyst-Internal/vera

# The repo that hosts the WO state files (today: same as VITE_VERA_REPO, in state/)
VITE_STATE_REPO=Catalyst-Internal/vera
VITE_STATE_BRANCH=main
